<div id="<%= dom_id booking %>">
  <div>
    <strong>Building:</strong>
    <%= booking.building %>
  </div>

  <div>
    <strong>Floor:</strong>
    <%= booking.floor %>
  </div>

  <div>
    <strong>Room:</strong>
    <%= booking.room %>
  </div>

  <div>
    <strong>Booked by:</strong>
    <%= booking.booked_by %>
  </div>

  <div>
    <strong>Starts at:</strong>
    <%= booking.starts_at %>
  </div>

  <div>
    <strong>Ends at:</strong>
    <%= booking.ends_at %>
  </div>

</div>
