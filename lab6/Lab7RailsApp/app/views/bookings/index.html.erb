<% content_for :title, "Бронювання" %>

<% content_for :booking_filters do %>
  <%= render "bookings/filters" %>
<% end %>

<% if notice.present? %>
  <p class="alert alert-success"><%= notice %></p>
<% end %>

<h1 class="mb-4">Бронювання переговорних</h1>

<% if @bookings.empty? %>
  <p>За цими умовами бронювань немає.</p>
<% end %>

<div id="bookings" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
  <% @bookings.each do |booking| %>
    <div class="col">
      <article class="card h-100">
        <% if booking.image.attached? %>
          <%= image_tag booking.image,
                alt: "Фото переговорної #{booking.room}",
                class: "card-img-top object-fit-cover",
                style: "height: 180px" %>
        <% end %>

        <div class="card-body">
          <h2 class="h5">
            <%= link_to "Переговорна #{booking.room}", booking_path(booking) %>
          </h2>

          <p><%= booking.building %>, поверх <%= booking.floor %></p>
          <p>Автор: <%= booking.user.name %></p>

          <% description = booking.description.to_s %>
          <% if description.present? %>
            <p><%= description[0, 100] %><%= "…" if description.length > 100 %></p>
          <% end %>
        </div>
      </article>
    </div>
  <% end %>
</div>